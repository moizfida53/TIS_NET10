{
  "ConnectionStrings": {
    "TIS": "Server=.\\SQLEXPRESS;Database=TIS_KDD_NEW;Integrated Security=true;TrustServerCertificate=true;"
  },
  "ActiveDirectory": {
    "Domain": "",
    "LdapPath": "LDAP://",
    "Attributes": {
      "DisplayName": "displayName",
      "Email": "mail",
      "Department": "department",
      "EmployeeNumber": "employeeNumber"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/tis-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "Sms": {
    "UserName": "",
    "Password": "",
    "SenderID": ""
  },
  "AllowedHosts": "*"
}

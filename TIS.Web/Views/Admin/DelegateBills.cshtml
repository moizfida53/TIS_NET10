@{
    ViewData["Title"] = "Bill Delegation";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0">Bill Delegation</h5>
    <button class="btn btn-sm btn-primary" id="btn-dlg-add">+ Add Delegation</button>
</div>

<table id="dt-dlg" class="table table-sm table-bordered table-striped w-100">
    <thead>
        <tr>
            <th>Manager</th><th>Secretary</th>
            <th>Can Identify</th><th>Can Approve</th>
            <th>Start Date</th><th>End Date</th>
            <th>Actions</th>
        </tr>
    </thead>
</table>

<!-- ════ Delegation Modal ════ -->
<div class="modal fade" id="modal-dlg" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="modal-dlg-title">Delegation</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="dlg-id" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label form-label-sm">Manager <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" id="dlg-manager"></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label form-label-sm">Secretary <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" id="dlg-secretary"></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label form-label-sm">Start Date</label>
                        <input type="text" class="form-control form-control-sm flatpickr" id="dlg-start" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label form-label-sm">End Date</label>
                        <input type="text" class="form-control form-control-sm flatpickr" id="dlg-end" />
                    </div>
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="dlg-identify" />
                            <label class="form-check-label" for="dlg-identify">Can Identify Bills</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="dlg-approve" />
                            <label class="form-check-label" for="dlg-approve">Can Approve Bills</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-sm btn-primary" id="btn-dlg-save">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="modal-dlg-del" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Remove Delegation</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><p>Remove this delegation?</p><input type="hidden" id="del-dlg-id" /></div>
            <div class="modal-footer">
                <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-sm btn-danger" id="btn-dlg-del-confirm">Remove</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modules/admin-delegate.js"></script>
}

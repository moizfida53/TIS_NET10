@{
    ViewData["Title"] = "Provider Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0">Provider Management</h5>
    <button class="btn btn-sm btn-primary" id="btn-prov-add">+ Add Provider</button>
</div>

<table id="dt-prov" class="table table-sm table-bordered table-striped w-100">
    <thead>
        <tr><th>Name</th><th>VOIP</th><th>Country ID</th><th>Actions</th></tr>
    </thead>
</table>

<!-- Add / Edit Provider Modal -->
<div class="modal fade" id="modal-prov" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-prov-title">Add Provider</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="prov-id" />
                <div class="mb-3">
                    <label class="form-label">Provider Name</label>
                    <input type="text" id="prov-name" class="form-control form-control-sm" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Country ID</label>
                    <input type="number" id="prov-country" class="form-control form-control-sm" value="0" />
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="prov-voip" />
                    <label class="form-check-label" for="prov-voip">Is VOIP</label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary btn-sm" id="btn-prov-save">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Provider Modal -->
<div class="modal fade" id="modal-prov-del" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="del-prov-id" />
                <p>Delete provider <strong id="del-prov-name"></strong>?</p>
                <p class="text-danger small">This will also delete all associated call records and bills.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger btn-sm" id="btn-prov-del-confirm">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modules/setting-provider.js"></script>
}

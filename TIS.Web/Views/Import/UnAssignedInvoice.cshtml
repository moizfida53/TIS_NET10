@{
    ViewData["Title"] = "Unassigned Bills";
}

<div class="page-header mb-3 d-flex justify-content-between align-items-center">
    <h4 class="mb-0">Unassigned Bills</h4>
    <div class="d-flex gap-2">
        <button id="btnExport" class="btn btn-sm btn-outline-success">
            <i class="fas fa-file-excel me-1"></i>Export to Excel
        </button>
        <button id="btnAssign" class="btn btn-sm btn-primary">
            <i class="fas fa-link me-1"></i>Assign Records
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblUnassigned" class="table table-sm table-bordered table-hover w-100">
                <thead class="table-dark">
                    <tr>
                        <th>Bill Date</th>
                        <th>Mobile</th>
                        <th>Provider</th>
                        <th>Total Amount</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modules/import-unassigned.js"></script>
}

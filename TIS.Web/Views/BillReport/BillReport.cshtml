@{
    ViewData["Title"] = "Bill Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Bill Report</h4>
    <button id="btnExport" class="btn btn-success btn-sm">
        <i class="bi bi-file-earmark-excel me-1"></i>Export to Excel
    </button>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-2">
                <label class="form-label">Month</label>
                <select id="cmbMonth" class="form-select form-select-sm">
                    <option value="0">All</option>
                    <option value="1">January</option>
                    <option value="2">February</option>
                    <option value="3">March</option>
                    <option value="4">April</option>
                    <option value="5">May</option>
                    <option value="6">June</option>
                    <option value="7">July</option>
                    <option value="8">August</option>
                    <option value="9">September</option>
                    <option value="10">October</option>
                    <option value="11">November</option>
                    <option value="12">December</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Year</label>
                <select id="cmbYear" class="form-select form-select-sm"></select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select id="cmbStatus" class="form-select form-select-sm">
                    <option value="0">All Statuses</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Company</label>
                <select id="cmbCompany" class="form-select form-select-sm">
                    <option value="0">All Companies</option>
                </select>
            </div>
            <div class="col-12 d-flex gap-2 justify-content-end">
                <button id="btnSearch" class="btn btn-primary btn-sm">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <button id="btnCancel" class="btn btn-secondary btn-sm">
                    <i class="bi bi-x-circle me-1"></i>Clear
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-2">
        <table id="tblBillReport" class="table table-striped table-hover table-sm w-100 nowrap">
            <thead class="table-dark">
                <tr>
                    <th>Emp No</th>
                    <th>Employee</th>
                    <th>Mobile</th>
                    <th>Mobile Desc</th>
                    <th>Bill Date</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Business</th>
                    <th class="text-end">Personal</th>
                    <th class="text-end">Pers. Limit</th>
                    <th class="text-end">Deductible</th>
                    <th>Cost Center</th>
                    <th>CC Code</th>
                    <th>Department</th>
                    <th>Payroll Cat.</th>
                    <th>Status</th>
                    <th>Company</th>
                    <th>Provider</th>
                    <th>Forced By</th>
                    <th>Forced Date</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/modules/bill-report.js"></script>
}

@{
    ViewData["Title"] = "Sync BAPI";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Sync BAPI</h4>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>SAP NCo Not Available</strong> — The SAP BAPI sync feature requires the SAP .NET Connector (NCo),
            which is not compatible with .NET 10. Please use the legacy system to run BAPI synchronization,
            or contact IT to set up the TIS.SapBridge console tool.
        </div>
    </div>
</div>
